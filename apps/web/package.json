{
  "name": "quantrift-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "motion:rollout-audit": "node scripts/motion-rollout-audit.mjs",
    "motion:rollout-audit:json": "node scripts/motion-rollout-audit.mjs --json",
    "motion:rollout-audit:strict": "node scripts/motion-rollout-audit.mjs --json --strict",
    "motion:rollout-audit:report": "node scripts/motion-rollout-audit.mjs --json --strict --report --report-path=docs/motion-rollout-audit-report.md",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "format:terminal": "prettier --write app/terminal app/api/auth/expire src/components/terminal src/lib/terminal tests/e2e/terminal-calculations.spec.ts tests/e2e/terminal.spec.ts docs/research-terminal.md",
    "format:terminal:check": "prettier --check app/terminal app/api/auth/expire src/components/terminal src/lib/terminal tests/e2e/terminal-calculations.spec.ts tests/e2e/terminal.spec.ts docs/research-terminal.md"
  },
  "dependencies": {
    "@next/env": "^15.3.1",
    "@tanstack/react-query": "^5.105.0",
    "lightweight-charts": "5.2.1",
    "next": "^15.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
